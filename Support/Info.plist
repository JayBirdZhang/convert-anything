<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle: where updates are announced, and the public half of the key they're signed with. -->
	<key>SUFeedURL</key>
	<string>https://github.com/JayBirdZhang/convert-anything/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>eq8DzqpmEUfAQkel8yvF1KWlNPmBVWvgE0hNNFnRe3Y=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Finder's "Convert to" menu hands its requests to the app as convertanything:// links. The app only
	     accepts ones sent by its own Finder extension (FinderMenu.swift). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.jaybirdzhang.ConvertAnything.convert</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>convertanything</string>
			</array>
		</dict>
	</array>
	<!-- Transcription (audio or video renamed to .txt, .srt or .vtt). Asked the first time it's used. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Convert Anything writes down what's said in audio and video you rename to .txt, .srt or .vtt. It all happens on your Mac.</string>
</dict>
</plist>
